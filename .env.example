# ──────────────────────────────────────────────────────────────
# KaspiTracker — local development environment variables
# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and MUST NEVER be committed.
# ──────────────────────────────────────────────────────────────

# ── Option A: Using Docker Compose (recommended) ──────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=kaspitracker
# DB_USER=kaspi
# DB_PASSWORD=kaspi_secret_change_me

# ── Option B: Using local pgAdmin4 / system PostgreSQL ────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=KaspiTracker
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

SERVER_PORT=8080

# ── Security Configuration ────────────────────────────────────
APP_USERNAME=admin
# The password MUST be a BCrypt hash.
# This is the hash for "changeme"
APP_PASSWORD=$2a$10$pl5W3xJJpejkcFZ2DEaZ6.hPWk.z36LjORBmTv8jL4fUr5.lEOKf6
